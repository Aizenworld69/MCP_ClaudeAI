{
  "manifest_version": "0.2",
  "name": "google-ads-mcp",
  "display_name": "Google Ads MCP Server",
  "version": "1.0.0",
  "description": "Google Ads Integration for Claude Desktop via Model Context Protocol (MCP)",
  "author": {
    "name": "AIZEN Team"
  },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${extensionPath}/dist/index.js"],
      "env": {
        "GOOGLE_ADS_CUSTOMER_ID": "${user_config.customer_id}",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${user_config.developer_token}",
        "GOOGLE_ADS_CLIENT_ID": "${user_config.client_id}",
        "GOOGLE_ADS_CLIENT_SECRET": "${user_config.client_secret}",
        "GOOGLE_ADS_REFRESH_TOKEN": "${user_config.refresh_token}",
        "MAX_DAILY_BUDGET_VND": "${user_config.max_daily_budget_vnd}"
      }
    }
  },
  "user_config": {
    "customer_id": {
      "type": "string",
      "title": "Google Ads Customer ID",
      "description": "10-digit Customer ID without dashes (e.g. 1234567890)",
      "required": true
    },
    "developer_token": {
      "type": "string",
      "title": "Developer Token",
      "description": "Google Ads API Developer Token",
      "required": true,
      "sensitive": true
    },
    "client_id": {
      "type": "string",
      "title": "OAuth Client ID",
      "description": "Google Cloud OAuth 2.0 Client ID",
      "required": true
    },
    "client_secret": {
      "type": "string",
      "title": "OAuth Client Secret",
      "description": "Google Cloud OAuth 2.0 Client Secret",
      "required": true,
      "sensitive": true
    },
    "refresh_token": {
      "type": "string",
      "title": "OAuth Refresh Token",
      "description": "OAuth 2.0 Refresh Token",
      "required": true,
      "sensitive": true
    },
    "max_daily_budget_vnd": {
      "type": "string",
      "title": "Max Daily Budget (VND)",
      "description": "Safety cap limit for daily budget in VND (default: 5000000)",
      "default": "5000000",
      "required": false
    }
  }
}
